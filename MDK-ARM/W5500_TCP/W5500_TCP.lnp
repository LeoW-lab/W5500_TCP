"w5500_tcp\stm32f1xx_hal_spi.o"
"w5500_tcp\stm32f1xx_hal.o"
"w5500_tcp\stm32f1xx_hal_rcc.o"
"w5500_tcp\stm32f1xx_hal_rcc_ex.o"
"w5500_tcp\stm32f1xx_hal_gpio.o"
"w5500_tcp\stm32f1xx_hal_dma.o"
